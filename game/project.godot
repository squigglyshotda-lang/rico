; Engine configuration file.
config_version=5

[application]

config/name="Rico"
config/description="Rico — a cheeky little desktop assistant"
config/version="1.5.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/icon.png"
config/windows_native_icon="res://assets/icon.ico"
run/max_fps=60
config/use_custom_user_dir=true
config/custom_user_dir_name="Rico"
boot_splash/bg_color=Color(0, 0, 0, 0)
boot_splash/show_image=false
boot_splash/use_filter=false

[audio]

driver/enable_input=true
general/text_to_speech=true

[autoload]

Cfg="*res://scripts/config.gd"

[display]

window/size/viewport_width=800
window/size/viewport_height=600
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true
window/subwindows/embed_subwindows=false
window/energy_saving/keep_screen_on=false
window/stretch/mode="disabled"

[gui]

theme/custom_font="res://assets/Fredoka.ttf"
theme/default_font_antialiasing=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
